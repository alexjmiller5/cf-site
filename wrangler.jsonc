{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "cf-site",
	"compatibility_date": "2026-07-06",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"vars": {
		// PostHog project API key (publishable, not a secret - ships in the client
		// bundle by design). Fill from the shared 1P item at scaffold time; empty
		// = analytics disabled. Dev stays keyless so local runs don't pollute data.
		"PUBLIC_POSTHOG_KEY": ""
	}
}
